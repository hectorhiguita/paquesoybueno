# Database
DATABASE_URL="postgresql://user:password@localhost:5432/santa_elena?schema=public"

# NextAuth
NEXTAUTH_URL="http://santaelenacomunidad.online"
NEXTAUTH_SECRET="your-secret-here"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_ENABLED="false"

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="santa-elena-images"
R2_PUBLIC_URL=""

# Web Push VAPID
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@santaelena.com"

# Twilio (SMS verification)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_PHONE_NUMBER="+1xxxxxxxxxx"

# Admin credentials
# Generar hash con: node scripts/gen-admin-hash.mjs <contraseña>
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""

# Email transaccional (AWS SES)
SES_FROM_EMAIL="noreply@santaelenacomunidad.online"

# App URL pública
NEXT_PUBLIC_APP_URL="https://santaelenacomunidad.online"

# Marca de agua de versión (inyectadas en build via --build-arg)
NEXT_PUBLIC_APP_VERSION="0.1.0"
NEXT_PUBLIC_GIT_COMMIT="local"
